                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "filename": {
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "size": {
                    "maximum": 4096,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "field",
                  "filename",
                  "contentType",
                  "size",
                  "sha256"
                ],
                "type": "object"
              },
              "maxItems": 1,
              "minItems": 1,
              "type": "array"
            },
            "item": {
              "description": "Item path, such as shelf-one/item-one",
              "type": "string"
            }
          },
          "required": [
            "item",
            "attachments"
          ],
          "type": "object"
        },
