      }
    },
    "batchCreateGamma": {
      "name": "body",
      "in": "body",
      "required": true,
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["gammaNumber", "gammaStatus"],
          "properties": {
            "gammaNumber": { "$ref": "#/definitions/gammaNumber" },
            "gammaStatus": { "$ref": "#/definitions/num" },
            "region": { "$ref": "#/definitions/region" }
          }
        }
      }
    },
    "deleteBeta": {
      "name": "body",
