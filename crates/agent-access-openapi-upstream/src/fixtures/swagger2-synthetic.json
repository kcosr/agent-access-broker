      "properties": {
        "status": { "type": "string", "enum": ["BAD_REQUEST", "UNAUTHORIZED", "NOT_FOUND", "CONFLICT", "INTERNAL_SERVER_ERROR"] },
        "message": { "type": "string" },
        "errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Page": {
      "type": "object",
      "description": "Pagination metadata.",
      "properties": {
        "current": { "$ref": "#/definitions/num32" },
        "total": { "$ref": "#/definitions/num32" },
        "size": { "$ref": "#/definitions/num32" },
        "next": { "type": "string", "description": "Opaque token for the next page, if any." }
      }
    },
    "alphaSearchResult": {
      "type": "array",
      "description": "Array of full resource A. NOTE: this definition intentionally shares its name with the global response of the same name, which wraps this array in a page envelope.",
      "items": { "$ref": "#/definitions/Alpha" }
    },
    "num": { "type": "integer", "example": 1234 },
    "num32": { "type": "integer", "format": "int32", "example": 1234 },
    "label": { "type": "string" },
    "stamp": { "type": "string", "format": "YYYY-MM-DD HH:mm:ss", "description": "Timestamp using the reference document's non-standard custom format." },
    "actor": { "type": "string" },
    "region": { "type": "string", "enum": ["REGION_A", "REGION_B", "REGION_C", "REGION_D"] },
    "flag": { "type": "string", "description": "Single-character flag. NOTE: intentionally has no enum here even though the Alpha model property of the same role declares an inline Y/N enum, mirroring an inconsistency in the reference document." },
    "gammaRef": { "type": "string", "example": "1234567890::" },
    "gammaNumber": { "type": "string", "example": "0000000001" },
    "gammaMetadata": { "type": "string", "example": "{\"sample\":[{\"field\":\"value\"}]}" }
  }
}
