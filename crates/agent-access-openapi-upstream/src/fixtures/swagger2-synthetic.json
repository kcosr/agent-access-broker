    "alphaCreated": { "description": "OK", "schema": { "$ref": "#/definitions/Alpha" } },
    "alphaUpdated": { "description": "OK", "schema": { "$ref": "#/definitions/Alpha" } },
    "alphaFamilyCreated": { "description": "Created", "schema": { "$ref": "#/definitions/AlphaFamily" } },
    "alphaSearchConflict": {
      "description": "Conflict",
      "schema": { "$ref": "#/definitions/errorResponse" },
      "examples": {
        "application/json": {
          "status": "CONFLICT",
          "message": "Search could not be executed with the given variables",
          "errors": ["alphaStatus could only take numeric values as input"]
        }
      }
    },
    "gammaCreated": { "description": "Created", "schema": { "$ref": "#/definitions/Gamma" } },
    "gammaCreateConflict": {
      "description": "Conflict",
      "schema": { "$ref": "#/definitions/errorResponse" },
      "examples": {
        "application/json": {
          "status": "CONFLICT",
          "message": "gammaNumber 0000000001 can not be added",
          "errors": ["gamma already existed: gammaNumber=0000000001"]
        }
      }
    },
    "gammaDeleted": { "description": "OK" },
    "gammaNotFound": {
      "description": "Not Found",
      "schema": { "$ref": "#/definitions/errorResponse" },
      "examples": {
        "application/json": {
          "status": "NOT_FOUND",
          "message": "gamma was not present",
          "errors": ["gamma was not present"]
        }
      }
    },
    "betaDeleted": { "description": "OK" },
    "deltaUpdated": { "description": "OK", "schema": { "$ref": "#/definitions/Delta" } },
    "zetaCreated": { "description": "OK", "schema": { "$ref": "#/definitions/Zeta" } },
    "zetaFound": { "description": "OK", "schema": { "$ref": "#/definitions/Zeta" } },
    "badRequestError": {
      "description": "Bad Request",
      "schema": { "$ref": "#/definitions/errorResponse" },
      "examples": {
        "application/json": {
          "status": "BAD_REQUEST",
          "message": "alpha can not be added",
          "errors": ["alphaName should be between 1 and 64 characters"]
        }
      }
    },
    "unauthorizedError": {
      "description": "Authentication information is missing or invalid",
      "schema": { "$ref": "#/definitions/errorResponse" },
      "examples": {
        "application/json": {
          "status": "UNAUTHORIZED",
          "message": "Invalid username and password",
          "errors": ["Invalid username and password"]
        }
      }
    },
    "notFoundError": { "description": "Not Found", "schema": { "$ref": "#/definitions/errorResponse" } },
    "conflictError": { "description": "Conflict", "schema": { "$ref": "#/definitions/errorResponse" } },
    "internalServerError": {
      "description": "Internal Server Error",
      "schema": { "$ref": "#/definitions/errorResponse" },
      "examples": {
        "application/json": {
          "status": "INTERNAL_SERVER_ERROR",
          "message": "Validation failed",
          "errors": ["implementation-level exception identifier (abstracted)"]
        }
      }
    }
  },
  "definitions": {
