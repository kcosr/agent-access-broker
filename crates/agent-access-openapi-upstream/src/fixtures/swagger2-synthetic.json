        }
      }
    },
    "updateDeltaByPath": {
      "name": "body",
      "in": "body",
      "required": true,
      "schema": {
        "type": "object",
        "required": ["deltaName"],
        "properties": {
          "deltaName": { "$ref": "#/definitions/label" },
          "deltaType": { "$ref": "#/definitions/num" },
          "addGammas": { "type": "string", "description": "Comma-separated identifiers to add." },
          "removeGammas": { "type": "string", "description": "Comma-separated identifiers to remove." },
          "beginTime": { "type": "string", "description": "10-digit Unix timestamp." }
        }
      }
    },
    "createZeta": {
      "name": "body",
      "in": "body",
      "required": true,
      "schema": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  },
  "responses": {
