      "name": "alphaNumber",
      "in": "path",
      "required": true,
      "type": "integer",
      "description": "Numeric identifier of resource A."
    },
    "deltaNumber": {
      "name": "deltaNumber",
      "in": "path",
      "required": true,
      "type": "integer",
      "description": "Numeric identifier of resource D."
    },
    "zetaId": {
      "name": "id",
      "in": "path",
      "required": true,
      "type": "integer",
      "format": "int32",
      "description": "Numeric identifier of resource F. NOTE: parameter map key differs from the name field, which is authoritative for the wire."
    },
    "pageFilter": {
      "name": "page",
      "in": "formData",
      "required": false,
      "type": "integer",
      "description": "Index of the page to view; the reference document's prose claims a fixed maximum page size."
    },
    "alphaNumberFilter": {
      "name": "alphaNumber",
      "in": "formData",
      "required": false,
      "type": "string",
      "description": "A list of 1 or more identifiers, separated by ','."
    },
    "alphaNameFilter": {
      "name": "alphaName",
      "in": "formData",
      "required": false,
      "type": "string",
      "description": "A list of 1 or more names, separated by ','."
    },
    "alphaStatusFilter": {
      "name": "alphaStatus",
      "in": "formData",
      "required": false,
      "type": "string",
      "description": "A list of 1 or more status codes, separated by ','."
    },
    "pageQuery": {
      "name": "page",
      "in": "query",
      "required": false,
      "type": "integer",
      "minimum": 1,
      "description": "Page index starting at 1."
    },
    "sourceEpsilonNumber": {
      "name": "sourceEpsilonNumber",
      "in": "formData",
      "required": true,
      "type": "integer",
      "description": "Identifier of the source aggregate."
    },
    "targetEpsilonNumber": {
      "name": "targetEpsilonNumber",
      "in": "formData",
      "required": true,
      "type": "integer",
      "description": "Identifier of the target aggregate."
    },
    "requiredGammaNumberFilter": {
      "name": "gammaNumber",
      "in": "formData",
      "required": true,
      "type": "string",
      "description": "The string identifier to delete."
    },
    "createAlpha": {
      "name": "body",
      "in": "body",
      "required": true,
      "schema": {
        "type": "object",
        "required": ["alphaType", "alphaName", "alphaStatus", "epsilonNumber"],
        "properties": {
          "alphaType": { "$ref": "#/definitions/num" },
          "alphaName": { "$ref": "#/definitions/label" },
          "alphaStatus": { "$ref": "#/definitions/num" },
          "epsilonNumber": { "$ref": "#/definitions/num32" },
          "alphaDescription": { "$ref": "#/definitions/label" },
