    "BetaName": {
      "type": "object",
      "description": "Named label for resource B.",
      "properties": {
        "name": { "$ref": "#/definitions/label" },
        "description": { "$ref": "#/definitions/label" },
        "added": { "$ref": "#/definitions/stamp" },
        "addedBy": { "type": "string" }
      }
    },
    "Gamma": {
      "type": "object",
      "description": "Resource C with a string identifier.",
