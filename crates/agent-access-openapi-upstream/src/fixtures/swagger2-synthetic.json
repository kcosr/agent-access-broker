        "gammaNumber": { "$ref": "#/definitions/gammaNumber" },
        "gammaDescription": { "$ref": "#/definitions/label" },
        "gammaStatus": { "$ref": "#/definitions/num" },
        "gammaStatusDescription": { "type": "string", "example": "Active" },
        "responseOrg": { "type": "string" },
        "region": { "$ref": "#/definitions/region" },
        "deltaNumber": { "$ref": "#/definitions/num" },
        "billingNumber": { "type": "string" },
        "sitePhone": { "type": "string" },
        "metadata": { "$ref": "#/definitions/gammaMetadata" },
        "created": { "$ref": "#/definitions/stamp" },
        "createdBy": { "$ref": "#/definitions/actor" },
        "modified": { "$ref": "#/definitions/stamp" },
        "modifiedBy": { "$ref": "#/definitions/actor" }
      }
    },
    "Delta": {
      "type": "object",
      "description": "Resource D with a numeric identifier; embeds a full reference to resource A.",
      "properties": {
        "deltaNumber": { "$ref": "#/definitions/num" },
        "deltaName": { "$ref": "#/definitions/label" },
        "deltaType": { "$ref": "#/definitions/num" },
        "description": { "$ref": "#/definitions/label" },
        "alpha": { "$ref": "#/definitions/Alpha" },
        "ownerNumber": { "type": "integer" },
        "handlerNumber": { "type": "integer" },
        "billingNumber": { "type": "integer" },
        "beginTime": { "type": "string", "description": "10-digit Unix timestamp." },
        "endTime": { "type": "string", "description": "10-digit Unix timestamp." },
        "gammaRefs": { "type": "array", "items": { "$ref": "#/definitions/gammaRef" } },
